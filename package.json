{
  "name": "mbalabs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/mba-labs-core run dev",
    "dev:core": "npm --prefix apps/mba-labs-core run dev",
    "dev:cotacoes": "npm run dev --workspace=mba-cotacoes",
    "dev:lavagestor": "npm run dev --workspace=lavagestor",
    "audit:ci": "node -e \"const{execSync}=require('child_process');let o='';try{o=execSync('npm audit --json',{encoding:'utf8',stdio:['ignore','pipe','pipe']})}catch(e){o=e.stdout||''}const a=JSON.parse(o);for(const[n,v]of Object.entries(a.vulnerabilities||{}))console.log('AUDIT',JSON.stringify({name:n,severity:v.severity,isDirect:v.isDirect,range:v.range,via:(v.via||[]).map(x=>typeof x==='string'?x:{name:x.name,title:x.title,severity:x.severity,range:x.range}),effects:v.effects,fixAvailable:v.fixAvailable}));console.log('AUDIT_META',JSON.stringify(a.metadata&&a.metadata.vulnerabilities||{}));\"",
    "build": "npm run audit:ci && npm --prefix apps/mba-labs-core run build",
    "build:all": "npm run build --workspaces --if-present",
    "build:cotacoes": "npm run build --workspace=mba-cotacoes",
    "build:core": "npm --prefix apps/mba-labs-core run build",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
