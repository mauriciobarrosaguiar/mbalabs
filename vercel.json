{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/*": false,
      "fix/*": false,
      "qa/*": false,
      "chore/*": false,
      "dependabot/*": false
    }
  },
  "env": {
    "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0"
  },
  "build": {
    "env": {
      "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0"
    }
  },
  "crons": [
    {
      "path": "/api/cotacoes/backup/supabase",
      "schedule": "0 8 * * *"
    }
  ]
}
