{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "env": {
    "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0"
  },
  "build": {
    "env": {
      "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0"
    }
  },
  "crons": [
    {
      "path": "/api/cotacoes/backup/supabase",
      "schedule": "0 8 * * *"
    }
  ]
}
